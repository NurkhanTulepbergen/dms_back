APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_ME

# Use the public origin that users open in the browser.
# Replace with https://your-domain later if a domain and TLS are added.
APP_URL=http://89.207.253.143
FRONTEND_URL=http://89.207.253.143

# Leave empty for IP-only deployment. For a real domain, use the bare host.
# Example: SESSION_DOMAIN=dms.example.kz
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=89.207.253.143

MYSQL_DATABASE=dms
MYSQL_USER=dms_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Keep the default when backend and frontend are served by the same nginx origin.
VITE_API_BASE_URL=/api/v1

# Change only if port 80 is already occupied on the server.
HTTP_PORT=80

# Defaults assume this file is in backend/deploy and frontend is cloned next to backend.
BACKEND_CONTEXT=..
FRONTEND_CONTEXT=../../unionist

# Optional: required only for real Stripe payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
