{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "^12.0",
        "stripe/stripe-php": "^19.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\User\\": "Modules/User/app/",
            "Modules\\User\\Database\\Factories\\": "Modules/User/database/factories/",
            "Modules\\User\\Database\\Seeders\\": "Modules/User/database/seeders/",
            "Modules\\Auth\\": "Modules/Auth/app",
            "Modules\\Auth\\Database\\Factories\\": "Modules/Auth/database/factories/",
            "Modules\\Auth\\Database\\Seeders\\": "Modules/Auth/database/seeders/",
            "Modules\\News\\": "Modules/News/app",
            "Modules\\News\\Database\\Factories\\": "Modules/News/database/factories/",
            "Modules\\News\\Database\\Seeders\\": "Modules/News/database/seeders/",
            "Modules\\Dormitory\\": "Modules/Dormitory/app",
            "Modules\\Dormitory\\Database\\Factories\\": "Modules/Dormitory/database/factories/",
            "Modules\\Dormitory\\Database\\Seeders\\": "Modules/Dormitory/database/seeders/",
            "Modules\\Requests\\": "Modules/Requests/app",
            "Modules\\Requests\\Database\\Factories\\": "Modules/Requests/database/factories/",
            "Modules\\Requests\\Database\\Seeders\\": "Modules/Requests/database/seeders/",
            "Modules\\Settlement\\": "Modules/Settlement/app",
            "Modules\\Settlement\\Database\\Factories\\": "Modules/Settlement/database/factories/",
            "Modules\\Settlement\\Database\\Seeders\\": "Modules/Settlement/database/seeders/",
            "Modules\\Finance\\": "Modules/Finance/app",
            "Modules\\Finance\\Database\\Factories\\": "Modules/Finance/database/factories/",
            "Modules\\Finance\\Database\\Seeders\\": "Modules/Finance/database/seeders/",
            "Modules\\Penalty\\": "Modules/Penalty/app",
            "Modules\\Penalty\\Database\\Factories\\": "Modules/Penalty/database/factories/",
            "Modules\\Penalty\\Database\\Seeders\\": "Modules/Penalty/database/seeders/",
            "Modules\\Gym\\": "Modules/Gym/app",
            "Modules\\Gym\\Database\\Factories\\": "Modules/Gym/database/factories/",
            "Modules\\Gym\\Database\\Seeders\\": "Modules/Gym/database/seeders/",
            "Modules\\BuySell\\": "Modules/BuySell/app",
            "Modules\\BuySell\\Database\\Factories\\": "Modules/BuySell/database/factories/",
            "Modules\\BuySell\\Database\\Seeders\\": "Modules/BuySell/database/seeders/"
        },
        "files": [
            "app/Helpers/result.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "post-install-cmd": [
            "@php artisan config:cache",
            "@php artisan route:cache",
            "@php artisan view:cache"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
